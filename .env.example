# Preenchido por `vercel env pull` após provisionar o Neon pelo Marketplace.
# NUNCA commitar valores reais — .env* está no .gitignore.
DATABASE_URL=

# Mercado Pago — assinatura. A conta é do CLIENTE; as chaves vêm de
# `vercel env`. Sem as duas, /api/webhook/mercadopago responde 503 em vez de
# fingir que processou o pagamento.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# 'false' aponta para produção do Mercado Pago. Qualquer outro valor (ou vazio)
# mantém o sandbox — o padrão seguro é não cobrar de verdade por engano.
MERCADOPAGO_SANDBOX=true

# Autentica as chamadas do Vercel Cron em /api/cron/*. A Vercel injeta esta
# variável automaticamente no projeto; preencha localmente para testar o job.
CRON_SECRET=

# Qual adapter da NBA é o primário no failover da ingestão. Padrão: provedor-a.
PROVEDOR_NBA=provedor-a
