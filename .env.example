# Preenchido por `vercel env pull` após provisionar o Neon pelo Marketplace.
# NUNCA commitar valores reais — .env* está no .gitignore.
DATABASE_URL=

# Mercado Pago — assinatura. A conta é do CLIENTE; as chaves vêm de
# `vercel env`. Sem as duas, /api/webhook/mercadopago responde 503 em vez de
# fingir que processou o pagamento.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# 'false' aponta para produção do Mercado Pago. Qualquer outro valor (ou vazio)
# mantém o sandbox — o padrão seguro é não cobrar de verdade por engano.
MERCADOPAGO_SANDBOX=true

# Rollout comercial. O checkout e o cadastro ficam fechados até estas decisões
# serem preenchidas e validadas no sandbox. O preço é inteiro em centavos e
# nunca é aceito de formulário/URL.
MERCADOPAGO_CHECKOUT_ENABLED=false
MERCADOPAGO_PREAPPROVAL_TYPE=pending
# Preços dos quatro SKUs, em centavos (spec de planos §10). Obrigatórios quando
# MERCADOPAGO_CHECKOUT_ENABLED=true: faltando um deles a leitura LANÇA e derruba
# /assinar e o webhook. Com o checkout desligado, a falta só esconde o preço.
PLANO_MVP_MENSAL_CENTAVOS=5990
PLANO_MVP_MENSAL_DE_CENTAVOS=7990
PLANO_MVP_TEMPORADA_CENTAVOS=39700
PLANO_ALL_STAR_MENSAL_CENTAVOS=9990
PLANO_ALL_STAR_MENSAL_DE_CENTAVOS=14900
PLANO_ALL_STAR_TEMPORADA_CENTAVOS=59700
# Último dia INCLUSIVE da temporada vendida, no fuso da rodada. Passada a
# data, o seletor esconde a modalidade temporada sozinho.
TEMPORADA_FIM=2027-06-30
# Plano grátis é conta: o cadastro fica aberto. 'false' fecha a porta numa emergência.
CADASTRO_PUBLICO_HABILITADO=true
APP_PUBLIC_URL=https://app.example.com
APP_ALLOWED_HOSTS=app.example.com

# Autentica as chamadas do Vercel Cron em /api/cron/*. A Vercel injeta esta
# variável automaticamente no projeto; preencha localmente para testar o job.
CRON_SECRET=

# Fontes NBA. Os nomes são namespaces de identidade imutáveis.
NBA_PRIMARIO_NOME=balldontlie
BALLDONTLIE_BASE_URL=https://api.balldontlie.io/nba/v1
BALLDONTLIE_API_KEY=
NBA_RESERVA_NOME=api-sports-nba
API_SPORTS_NBA_BASE_URL=https://v2.nba.api-sports.io
API_SPORTS_NBA_KEY=
NBA_TIMEOUT_MS=8000
NBA_RESERVA_OBRIGATORIA=true
NBA_INGESTAO_HABILITADA=false
NBA_RODADA_SOBREPOSICAO_DIAS=2

# Usadas apenas pelo comando `npm run admin:bootstrap`. Não configure estas
# variáveis permanentemente no runtime e remova os valores após a primeira
# criação. Consulte docs/runbooks/bootstrap-admin.md.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Web Push. Gere um par VAPID estável por ambiente; nunca versione a chave
# privada. Até as Specs 04/05, PUSH_ENABLED continua false e somente a
# allowlist interna (UUID ou e-mail, separada por vírgula) recebe eventos.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@example.com
PUSH_ENABLED=false
PUSH_INTERNAL_ALLOWLIST=

# Limites operacionais validados no startup dos consumers.
PUSH_BATCH_SIZE=100
PUSH_SEND_CONCURRENCY=10
PUSH_VISIBILITY_TIMEOUT_SECONDS=120
PUSH_RETRY_BASE_SECONDS=30

# Alerta operacional (W2-5): webhook genérico (Slack/Discord/Zapier aceitam
# JSON) para falha que hoje só existia em log. Canal definitivo aguarda o
# cliente (G8); sem esta variável, o aviso fica só no log estruturado.
ALERTA_WEBHOOK_URL=
