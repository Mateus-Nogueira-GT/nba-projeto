{
  "name": "ia-da-nba",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "deploy": "vercel deploy --yes",
    "deploy:prod": "vercel deploy --prod --yes",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:spec01": "vitest run src/modules/ingestao src/modules/dominio/__tests__/persistencia.test.ts src/modules/entrega/__tests__/fire-live.test.ts src/modules/entrega/__tests__/inicio-fire-live.test.ts src/modules/entrega/__tests__/cron.test.ts",
    "test:spec02": "vitest run src/modules/entrega/push src/modules/plataforma/__tests__/push.test.ts src/app/api/push/__tests__/routes.test.ts src/components/pwa src/modules/entrega/__tests__/fire-live.test.ts src/modules/dominio/__tests__/persistencia.test.ts",
    "test:spec03": "vitest run src/components/pwa src/app/__tests__/pwa.test.ts",
    "test:spec04": "vitest run src/modules/plataforma/__tests__/spec04.test.ts src/modules/plataforma/__tests__/pagamento-estabilizacao.test.ts src/modules/plataforma/__tests__/plataforma.test.ts src/modules/plataforma/__tests__/push.test.ts src/app/api/push/__tests__/routes.test.ts src/app/__tests__/paywall.test.ts src/modules/dominio/__tests__/persistencia.test.ts",
    "db:generate": "drizzle-kit generate && node scripts/gerar-down.mjs",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "admin:bootstrap": "vite-node scripts/bootstrap-admin.ts",
    "cortesia": "vite-node scripts/conceder-cortesia.ts",
    "demo:seed": "vite-node scripts/demo-seed.ts",
    "demo:limpar": "vite-node scripts/demo-limpar.ts",
    "demo:fotos": "vite-node scripts/demo-fotos.ts",
    "ingestao:backfill": "vite-node scripts/backfill-ingestao.ts",
    "tokens": "vite-node scripts/gerar-tokens-css.mts",
    "pwa:assets": "vite-node scripts/gerar-assets-pwa.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/queue": "^0.4.0",
    "bufferutil": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7",
    "workflow": "^4.8.4",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "nanoid@>=4 <5.1.16": "5.1.16",
    "undici@>=7 <7.29.0": "7.29.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vercel/config": "^0.6.1",
    "dependency-cruiser": "^18.2.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
