# Sem barra final: em worktree `node_modules` costuma ser um SYMLINK, e
# `node_modules/` casa só com DIRETÓRIO — foi por essa fresta que um link
# para um caminho do notebook entrou no repositório com `git add -A`.
node_modules
.next/
out/
build/
coverage/
.env
.env.*
!.env.example
.vercel
.DS_Store
*.tsbuildinfo
next-env.d.ts
/.swc

# Gerado por `@vercel/config` a partir de vercel.ts — nunca versionar.
vercel.json
.env*.local
.superpowers/

# Scripts de diagnóstico descartáveis — nunca no repositório. Um deles chegou
# à main por um `git add -A` carregando um token de sessão (revogado em
# 27/08/2026); este padrão fecha a porta.
scripts/*.tmp.ts
scripts/*.tmp.mjs

# Playwright (e2e/, fora do CI)
test-results/
playwright-report/
